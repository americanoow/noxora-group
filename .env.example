# URL pública do site (canonical, Open Graph, sitemap, JSON-LD).
# OBRIGATÓRIA no build de produção: o build falha se estiver ausente, vazia ou inválida.
# Em desenvolvimento local, use http://localhost:3000.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# E-mail de contato. Sem configuração, usa groupnoxora@gmail.com.
# Lido no build: alterar exige um novo build.
CONTACT_EMAIL=

# WhatsApp: somente dígitos, com DDI e DDD (ex.: 5511999999999).
# Lido no build; sem ele, o cartão informa que o número está em definição.
WHATSAPP_NUMBER=

# Destino do formulário de contato (POST JSON: name, email, company, message, source).
# SOMENTE servidor: nunca use NEXT_PUBLIC_ nem exponha em componentes client.
# Sem ele, o formulário avisa que o envio está indisponível e nunca simula sucesso.
CONTACT_WEBHOOK_URL=

# Opcional: tempo limite da entrega, em ms (padrão 8000).
CONTACT_WEBHOOK_TIMEOUT_MS=
