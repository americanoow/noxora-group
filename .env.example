# URL pública do site (canonical, Open Graph, sitemap, JSON-LD).
# OBRIGATÓRIA no build de produção: o build falha se estiver ausente, vazia ou inválida.
# Em desenvolvimento local, use http://localhost:3000.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# E-mail de contato. Sem ele, o cartão informa que o endereço está em definição.
# Lido no build: alterar exige um novo build.
CONTACT_EMAIL=

# WhatsApp: somente dígitos, com DDI e DDD (ex.: 5511999999999).
# Lido no build; sem ele, o cartão informa que o número está em definição.
WHATSAPP_NUMBER=
